{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "packages": {
    "sdks/python": {
      "release-type": "python",
      "package-name": "daraja-sdk-py",
      "component": "daraja-sdk-py",
      "initial-version": "0.2.0",
      "extra-files": [
        {
          "type": "generic",
          "path": "src/daraja/__init__.py"
        },
        {
          "type": "generic",
          "path": "src/daraja/cli.py"
        }
      ]
    },
    "sdks/typescript": {
      "release-type": "node",
      "package-name": "@daraja-sdk/ts",
      "component": "daraja-sdk-ts",
      "initial-version": "0.2.0",
      "extra-files": [
        {
          "type": "generic",
          "path": "src/environment.ts"
        }
      ]
    },
    "sdks/go": {
      "release-type": "go",
      "package-name": "daraja-sdk-go",
      "component": "sdks/go",
      "tag-separator": "/",
      "initial-version": "0.2.0",
      "extra-files": [
        {
          "type": "generic",
          "path": "cli/main.go"
        }
      ]
    }
  }
}