{
  "name": "daraja-mcp",
  "version": "0.0.1",
  "private": true,
  "description": "Self-hosted MCP server for Safaricom M-Pesa Daraja API access (not an npm package)",
  "type": "module",
  "scripts": {
    "prebuild": "npm --prefix ../sdks/typescript run build",
    "build": "tsc",
    "clean": "rm -rf dist",
    "prelint": "npm --prefix ../sdks/typescript run build",
    "lint": "tsc --noEmit",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "pretest": "npm --prefix ../sdks/typescript run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@daraja-sdk/ts": "file:../sdks/typescript",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8",
    "@vitest/coverage-v8": "4.1.11"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
