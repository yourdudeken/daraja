{
  "name": "daraja-mcp",
  "version": "0.0.1",
  "private": true,
  "description": "Self-hosted MCP server for Safaricom M-Pesa Daraja API access",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "daraja-sdk-ts": "0.0.4",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "4.1.11",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}