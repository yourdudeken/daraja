{
  "name": "daraja",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for the Daraja (M-Pesa) SDKs and MCP server",
  "scripts": {
    "build:index": "tsx scripts/build-index.ts",
    "ingest:docs": "tsx scripts/ingest-docs.ts",
    "validate:docs": "tsx scripts/validate-docs.ts",
    "build:mcp": "npm --prefix mcp run build",
    "test:mcp": "npm --prefix mcp run test"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "workspaces": [
    "mcp"
  ]
}
